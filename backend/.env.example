# Backend Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./music.db

# Audius API Configuration
# Audius does not require an API key; app_name helps with discovery node tracking
AUDIUS_APP_NAME=SpotifyClonePersonal

# Jamendo API Configuration (Optional)
# Obtain a free client ID from https://developer.jamendo.com/v3.0
JAMENDO_CLIENT_ID=
